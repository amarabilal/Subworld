{% extends 'base.html.twig' %}

{% block title %}
	{{ subworld.name }}
	- Community
{% endblock %}

{% block content %}
	<div
		class="max-w-2xl mx-auto mt-6 space-y-4">

		<!-- Subworld Details -->
        <div class="bg-white shadow-md rounded-lg p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex flex-col items-center md:items-start md:col-span-1">
                <h1 class="text-3xl font-bold text-gray-900">{{ subworld.name }}</h1>
                <p class="text-gray-700 mt-4">{{ subworld.description }}</p>
                <p class="text-sm text-gray-500 mt-2">Created on {{ subworld.createdAt|date("F j, Y") }}</p>
                <p class="text-sm text-gray-500 mt-1">
                    <span id="member-count">{{ member_count }}</span> Members
                </p>
            </div>
            <div class="flex flex-col items-center md:items-end md:col-span-1">
                <!-- Join/Leave Button -->
                <button id="join-leave-btn" data-subworld="{{ subworld.id }}" data-action="{% if app.user in subworld.members %}leave{% else %}join{% endif %}"
                    class="relative flex items-center px-4 py-2 {% if app.user in subworld.members %}bg-red-500{% else %}bg-blue-500{% endif %} text-white rounded-md justify-center">
                    
                    <svg id="loading-spinner" class="hidden animate-spin h-5 w-5 text-white" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M4 12a8 8 0 018-8"></path>
                    </svg>
                    
                    <span id="btn-text">{% if app.user in subworld.members %}Leave{% else %}Join{% endif %}</span>
                </button>
            </div>
        </div>

		<!-- Posts in Subworld -->
		<h2 class="text-xl font-semibold mt-6">Posts</h2>

		{% for post in posts %}
			<div
				class="bg-white shadow-md rounded-lg p-4 flex">

				<!-- Voting System -->
				<div
					class="flex flex-col items-center pr-4">
					<!-- Upvote -->
					<button class="hover:scale-110 transition-transform">
						<img src="{{ asset('assets/svg/shift.svg') }}" alt="Upvote" class="w-6 h-6">
					</button>
					<!-- Vote Count -->
					<span class="text-gray-700 font-semibold">{{ post.vote_count }}</span>
					<!-- Downvote (Rotated 180 degrees) -->
					<button class="hover:scale-110 transition-transform">
						<img src="{{ asset('assets/svg/shift.svg') }}" alt="Downvote" class="w-6 h-6 rotate-180">
					</button>
				</div>

				<!-- Post Content -->
				<div
					class="w-full">
					<!-- Post Title -->
					<h2 class="text-lg font-bold text-gray-900">
						<a href="{{ path('app_post_show', { 'id': post.post_id }) }}" class="hover:underline">{{ post.title }}</a>
					</h2>

					<!-- Metadata -->
					<p class="text-sm text-gray-500">
						Posted by
						<a href="{{ path('app_user_show', { 'id': post.user_id }) }}" class="text-blue-600 hover:underline">{{ post.author }}</a>
						·
						{{ post.createdAt|date('F j, Y') }}
					</p>

					<!-- Post Body -->
					<p class="mt-2 text-gray-800">{{ post.content|length > 300 ? post.content|slice(0, 300) ~ '...' : post.content }}</p>

					<!-- Comments & Interactions -->
					<div class="mt-3 flex items-center space-x-4">
						<a href="{{ path('app_post_show', { 'id': post.post_id }) }}" class="flex items-center text-gray-600 hover:text-blue-600">
							<svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 5h6m-6 4h6m-6 4h6m-6 4h6"></path>
							</svg>
							{{ post.comment_count }}
							Comments
						</a>
					</div>
				</div>
			</div>
		{% else %}
			<p class="text-gray-500">No posts in this community yet.</p>
		{% endfor %}

	</div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const token = localStorage.getItem("jwt_token");
            const button = document.getElementById("join-leave-btn");
            const loadingSpinner = document.getElementById("loading-spinner");
            const buttonText = document.getElementById("btn-text");
            const memberCountText = document.getElementById("member-count");
            const subworldId = button.getAttribute("data-subworld");

            // Fetch the latest subworld data when the page loads
            fetch(`/api/subworlds/subworld/${subworldId}`)
                .then(response => response.json())
                .then(data => {
                    // Update member count
                    memberCountText.textContent = data.member_count;

                    // Update button state dynamically
                    if (data.is_member) {
                        buttonText.textContent = "Leave";
                        button.setAttribute("data-action", "leave");
                        button.classList.remove("bg-blue-500");
                        button.classList.add("bg-red-500");
                    } else {
                        buttonText.textContent = "Join";
                        button.setAttribute("data-action", "join");
                        button.classList.remove("bg-red-500");
                        button.classList.add("bg-blue-500");
                    }
                })
                .catch(error => console.error("Error fetching subworld status:", error));

            button.addEventListener("click", function () {
                const action = this.getAttribute("data-action");
                const url = `/api/subworlds/subworld/${subworldId}/${action}`;

                // Show loading spinner, hide text
                loadingSpinner.classList.remove("hidden");
                buttonText.classList.add("hidden");
                button.disabled = true;

                fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-CSRF-Token": "{{ csrf_token('join_leave_subworld') }}",
                        "Authorization": "Bearer " + token
                    }
                })
                .then(response => response.json())
                .then(data => {
                    // Update button state after action
                    if (data.status === "joined") {
                        buttonText.textContent = "Leave";
                        button.setAttribute("data-action", "leave");
                        button.classList.remove("bg-blue-500");
                        button.classList.add("bg-red-500");
                    } else if (data.status === "left") {
                        buttonText.textContent = "Join";
                        button.setAttribute("data-action", "join");
                        button.classList.remove("bg-red-500");
                        button.classList.add("bg-blue-500");
                    }

                    // Update member count dynamically
                    if (data.member_count !== undefined) {
                        memberCountText.textContent = data.member_count;
                    }
                })
                .catch(error => console.error("Error:", error))
                .finally(() => {
                    // Hide loading spinner, show text again
                    loadingSpinner.classList.add("hidden");
                    buttonText.classList.remove("hidden");
                    button.disabled = false;
                });
            });
        });
    </script>
{% endblock %}
